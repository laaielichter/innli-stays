{
  "name": "innli-stays",
  "version": "2.0.0",
  "description": "Self-hosted MCP + REST server that lets AI agents search, quote and request bookings at B&Bs and small hotels, from facts the owner confirmed. Unknown stays unknown.",
  "mcpName": "io.github.laaielichter/innli",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "travel",
    "hospitality",
    "bed-and-breakfast",
    "hotel-booking",
    "direct-booking",
    "self-hosted",
    "booking-engine",
    "claude"
  ],
  "homepage": "https://github.com/laaielichter/innli-stays#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laaielichter/innli-stays.git"
  },
  "bugs": {
    "url": "https://github.com/laaielichter/innli-stays/issues"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "innli-stays": "build/main.js",
    "innli": "build/main.js",
    "innli-admin": "build/cli.js",
    "innli-mcp": "build/mcp/stdio.js"
  },
  "files": [
    "build",
    "public",
    "agent-kit",
    "CHANGELOG.md",
    "README.en.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "demo": "INNLI_DEMO=1 node src/main.ts",
    "setup": "node src/cli.ts init",
    "innli": "node src/cli.ts",
    "gids": "node src/directory/main.ts",
    "licentie": "node tools/license.ts",
    "mcp:stdio": "node src/mcp/stdio.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint:php": "find wordpress-plugin -name '*.php' -print0 | xargs -0 -n1 php -l",
    "bench": "node scripts/bench.ts",
    "pakket": "node scripts/package.ts",
    "demo:intl": "INNLI_DEMO=intl INNLI_LANG=en node src/main.ts",
    "measure": "node scripts/measure.ts",
    "research:injection": "node research/injection-eval.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "smoke:npm": "node scripts/smoke-npm.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "nodemailer": "^10.0.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2"
  }
}
