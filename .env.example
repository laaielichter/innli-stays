# Kopieer naar .env en vul in.

# Het publieke adres waarop agents en gasten INNLI bereiken (zonder / aan het eind).
INNLI_PUBLIC_URL=https://innli.jouwdomein.nl

# Alleen nodig als je meerdere accommodaties beheert via /api/admin (SaaS).
# Maak een lange willekeurige waarde, bijv.: openssl rand -base64 32
INNLI_ADMIN_KEY=

# 1 = alleen agents met een sleutel mogen de koppeling gebruiken.
INNLI_REQUIRE_AGENT_KEY=

# 1 = je boekingssysteem draait op je eigen netwerk (bijv. op dezelfde pc).
INNLI_ALLOW_PRIVATE_FETCH=

# Adres van de INNLI-gids. Met een geldige licentie wordt je accommodatie daar vindbaar voor AI-agents.
INNLI_GIDS_URL=

# E-mail voor aanvragen (gegevens van je eigen mailbox). Leeg = aanvragen alleen in het dashboard.
# Let op: @ in de gebruikersnaam schrijf je als %40.
INNLI_SMTP_URL=
INNLI_MAIL_FROM=

# Cloudflare Tunnel-token (Zero Trust → Networks → Tunnels → je tunnel → token).
TUNNEL_TOKEN=

# Docker: een kant-en-klaar image, bijv. ghcr.io/<eigenaar>/innli:2.0.0. Leeg = bouwen uit deze map.
INNLI_IMAGE=
